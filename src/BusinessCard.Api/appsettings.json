{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "None",
      "Microsoft.EntityFrameworkCore.Update": "None"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "BusinessCard.Api",
    "Audience": "BusinessCard.Frontend",
    "Key": "",
    "ExpiryMinutes": 480
  },
  "Auth": {
    "PasswordExpiryDays": 90,
    "LoginAttemptsPerMinute": 10
  },
  "Analytics": {
    "TimeZone": "Asia/Baku",
    "DuplicateWindowSeconds": 30
  },
  "Storage": {
    "UploadsPath": "wwwroot/uploads",
    "OriginalsPath": "storage/originals",
    "MaxUploadBytes": 10485760
  },
  "App": {
    "PublicCardBaseUrl": "http://127.0.0.1:5173/v/"
  },
  "Cors": {
    "AllowedOrigins": [ "http://127.0.0.1:5173", "http://localhost:5173" ]
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Swagger": {
    "Enabled": false
  },
  "Seed": {
    "SuperAdminEmail": "",
    "SuperAdminPassword": ""
  }
}
